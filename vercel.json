{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/sync-standings",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/fifa",
      "destination": "/fifa.html"
    },
    {
      "source": "/f1",
      "destination": "/f1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
