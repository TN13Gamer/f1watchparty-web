{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/sync-standings.js": {
      "maxDuration": 60
    },
    "api/fifa/fixtures.js": {
      "maxDuration": 60
    },
    "api/fifa/streams.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-fifa",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/sync-standings",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/fifa",
      "destination": "/fifa.html"
    },
    {
      "source": "/f1",
      "destination": "/f1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
