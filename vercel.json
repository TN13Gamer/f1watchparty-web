{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/fifa",
      "destination": "/fifa.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
