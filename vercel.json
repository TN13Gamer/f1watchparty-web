{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    },
    {
      "src": "*.webm",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-standings",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat/:path",
      "destination": "/api/chat/:path.js"
    },
    {
      "source": "/api/fifa/:path",
      "destination": "/api/fifa/:path.js"
    },
    {
      "source": "/api/:path",
      "destination": "/api/:path.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/fifa",
      "destination": "/fifa.html"
    },
    {
      "source": "/f1",
      "destination": "/f1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
